# Copy to .env and adjust. Never commit the real .env.
POSTGRES_DB=nexdesk
POSTGRES_USER=nexdesk
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8080
WEB_BASE_URL=http://localhost:4200
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-characters
# Shared secret the inbound email webhook expects in the X-Inbound-Secret header (16+ characters).
INBOUND_SECRET=replace-with-a-random-inbound-secret
# The platform admin, created on first start if this address has no account yet. The password needs
# at least 12 characters and is used only for that first creation.
PLATFORM_ADMIN_EMAIL=admin@nexdesk.local
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-admin-password
# Set to true only to try outbound webhooks against a receiver on this machine or network.
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
# Request limits per address, member and API key. Turn off only for load tests or long E2E runs.
RATE_LIMITING_ENABLED=true
